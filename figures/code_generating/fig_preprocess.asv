
%Create pre-processing figure

% Use this trial as example
iTrial = 1;
trial_data = P01.RightFoot_GaitCycle_Data.Level_Ground.Walking.Self_Selected_Speed(iTrial);  

%% Start with EMG filtering process

% per data collection paper (Data Records section), use this conversion
% factor to convert from arbitrary units to mV
mV_conversion_factor = 0.000286;
emg_raw = trial_data.RightLeg_EMG * mV_conversion_factor;


% Process EMG Data
fs_EMG = 2000;
nMuscles = 64;

emg_processed = zeros(size(emg_raw)); 

% Butterworth filter between 20 and 500 hz
filtMax = 500;
filtMin = 20;

L = length(emg_raw);
f = fs_EMG*(0:(L/2))/L;
bp_lower = filtMin / (max(f));
bp_upper = filtMax / (max(f));

[bp_b, bp_a] = butter(4, [bp_lower bp_upper], "bandpass");

for iMuscle = 1:nMuscles
    % Apply bandstop filter at multiples of 60 Hz
    % This accounts for powerline noise
    EMG_filtered = filter(bp_b, bp_a, emg_raw(:,iMuscle));
    bs = 60;
    while bs < filtMax
        bs_upper = (bs+2)/ (max(f));
        bs_lower = (bs-2)/ (max(f));
        [bs_b, bs_a] = butter(4, [bs_lower bs_upper], "stop");
        EMG_filtered = filter(bs_b, bs_a, EMG_filtered);
        bs = bs + 60;
    end
    emg_processed(:,iMuscle) = EMG_filtered;
end

%% Generate EMG Processing Fig

start_time = trial_data.IK.time(1);
end_time = trial_data.IK.time(end);
t_EMG = [start_time:(1/fs_EMG):end_time];

EMG_Plot_Chans = 1;
segLength = 0.1;

figure('Position',[200,200,900,300])
tiledlayout(1, 3)
for iCol = 1:3
    nexttile;
    hold on
    if iCol == 1
        plot(t_EMG, emg_raw(1:size(t_EMG,2),EMG_Plot_Chans), 'LineWidth',1.5);
        ylabel("EMG Signal (mV)");
    else
        plot(t_EMG, emg_processed(1:size(t_EMG,2),EMG_Plot_Chans), 'LineWidth',1.5);
        yticklabels([])
        yticks([-1,-0.5, 0, 0.5, 1])
        if iCol == 2
            xlabel("Time (s)");
        end
        if iCol == 3
            for segmentCutoff = start_time:segLength:end_time
                plot([segmentCutoff, segmentCutoff], [-1,1], Color="#D95319", LineStyle='-.')
            end
        end
    end
    xlim([start_time, end_time])
    ylim([-1,1])
    set(gca, 'FontName', 'Arial', 'FontWeight', 'bold', 'FontSize', 14)
end

%% 

dt = 0.01;

joint_values = zeros(height(trial_data.IK), 3);
joint_values(:,1) = trial_data.IK.('ankle_angle_r');
t_angle = trial_data.IK.time;

% differentiate to get velocities
joint_values(:,2) = [diff(joint_values(:,1));0] /dt;

% differentiate again to get accelerations
joint_values(:,3) = [diff(joint_values(:,2));0] /dt;

filt_cut = 10;
filt_joint_values = lowpass(joint_values,filt_cut,1/dt);

rowLabels = ["Angle ($^{\circ}$)", "Velocity ($\frac{\circ}{s}$)", "Acceleration ($\frac{\circ}{s^2}$)"];

figure('Position',[200,200,900,400])
tiledlayout(3,3, 'TileSpacing',)
for iRow = 1:3
    for iCol = 1:3
        nexttile;
        hold on;
        if iCol == 1
            plot(t_angle,joint_values(:,iRow))
            ylabel(rowLabels(iRow), 'Interpreter','latex')
        else
            plot(t_angle,filt_joint_values(:,iRow))
        end
        xlim([t_angle(1), t_angle(end)])
        set(gca, 'FontName', 'Arial', 'FontWeight', 'bold', 'FontSize', 12)
    end
end

